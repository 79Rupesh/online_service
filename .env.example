# ===================================================
# MP Suvidha: Environment Configuration Example
# Copy this file to .env and configure your variables
# ===================================================

# Application environment: development | production
FLASK_ENV=development
FLASK_DEBUG=1

# Secret Key for session and token signing
# IMPORTANT: In production, generate a secure random 32+ character key
# e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=mpsuvidha-dev-secret-key-change-in-production-2026

# Server Host and Port
HOST=127.0.0.1
PORT=5000

# Database path (optional override)
# MP_SUVIDHA_DB=instance/mpsuvidha.db

# Seed demo data on initial database creation (1 = yes, 0 = no)
SEED_DEMO_DATA=0
